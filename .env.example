# Connection string "pooled" de Neon (debe contener "-pooler" en el host)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cadena aleatoria larga usada para firmar la cookie de sesión (se emite al validar el PIN)
SESSION_SECRET=cambia-esta-cadena-aleatoria-larga

# Opcional: puerto local (Render lo asigna automáticamente en producción)
PORT=3000
